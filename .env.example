# AI Learning Path Generator — Environment Variables Example
# Copy this file to .env and provide your actual API keys. Never commit .env to source control!

PORT=5000
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-string

# AI Provider Configuration (For Phase 4 AI Roadmap Generation)
# Supported providers: GEMINI, OPENAI, ANTHROPIC, etc.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# MCP Server Configuration (For Phase 3 MCP Integration)
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_AUTH_TOKEN=your_mcp_auth_token_here
